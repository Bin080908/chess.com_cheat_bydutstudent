{
  "manifest_version": 3,
  "name": "Chess Coach (chess.com)",
  "version": "1.0.0",
  "description": "Hiện nước đi tốt nhất trên chess.com để luyện tập. Stockfish chạy local.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chess Coach"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.chess.com/*", "https://chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://chess.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
